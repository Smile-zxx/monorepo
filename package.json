{
  "name": "cursor-monorepo",
  "version": "1.0.0",
  "description": "A pnpm-based monorepo project",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "publish": "sh ./ publish-interactive.sh",
    "dev": "pnpm -r dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:packages": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "addpkg": "node repoTools/addNewPackage.js",
    "pubpkg": "node repoTools/publishPackage.js",
    "coco": "node repoTools/coco.js",
    "install-tb": "pnpm install --registry=https://registry.npmmirror.com",
    "start-admin": "pnpm --filter @smileznpm/admin dev"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "jest-environment-jsdom": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}